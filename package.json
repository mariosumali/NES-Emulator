{
  "name": "nes-station",
  "private": true,
  "version": "1.0.0",
  "description": "A fast, offline NES emulator for the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types scripts/verify-gamegenie.mjs",
    "check": "tsc -b && eslint . && npm test",
    "icons": "node scripts/generate-icons.mjs",
    "test-rom": "node scripts/make-test-rom.mjs"
  },
  "dependencies": {
    "jsnes": "^1.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
